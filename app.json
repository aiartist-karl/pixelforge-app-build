{
  "expo": {
    "name": "PixelForgeAI",
    "slug": "pixelforge-app",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./src/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain",
      "image": "./src/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixelforge.app",
      "newArchEnabled": false,
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄参考图片进行AI创作",
        "NSPhotoLibraryUsageDescription": "用于选择参考图片进行AI创作",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pixelforge.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "9902ec8c-9582-4cfa-87bf-c09ecdbd46d4"
      }
    },
    "owner": "ahuaj"
  }
}